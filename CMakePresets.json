{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows x64 (MSVC, Ninja)",
      "description": "VSCode CMake Tools auto-injects the MSVC x64 environment (cl.exe, INCLUDE, LIB) when it sees CMAKE_C/CXX_COMPILER=cl.exe plus an external architecture. From a plain shell, still run from a Developer PowerShell/Command Prompt for Visual Studio.",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "windows-no-ftdi",
      "displayName": "Windows x64 (MSVC, Ninja, no FTDI)",
      "description": "Same as 'windows' but with MSTAR_ENABLE_FTDI=OFF, building into its own build/windows-no-ftdi directory. Verifies mstar-core stays hardware-independent without needing the D2XX/LibMPSSE SDKs.",
      "inherits": "windows",
      "cacheVariables": {
        "MSTAR_ENABLE_FTDI": "OFF"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux x64 (GCC/Clang)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows",
      "configurePreset": "windows"
    },
    {
      "name": "windows-no-ftdi",
      "configurePreset": "windows-no-ftdi"
    },
    {
      "name": "linux",
      "configurePreset": "linux"
    }
  ],
  "testPresets": [
    {
      "name": "windows",
      "configurePreset": "windows"
    },
    {
      "name": "windows-no-ftdi",
      "configurePreset": "windows-no-ftdi"
    },
    {
      "name": "linux",
      "configurePreset": "linux"
    }
  ]
}
