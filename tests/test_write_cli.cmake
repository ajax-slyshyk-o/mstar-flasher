no_mutations()
expect("MODEL_READS raw_pages=0 main_before_erase=0")
run_image(no-backup-config-dry-preserve 0 write auto --config "${config}" --dry-run --preserve-gaps)
no_mutations()
expect("MODEL_READS raw_pages=0 main_before_erase=192")
