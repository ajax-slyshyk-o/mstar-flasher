# Real CLI and ISP protocol, backed by stateful NAND; no hardware access.
file(MAKE_DIRECTORY "${TEST_ROOT}")
string(REPEAT "A" 131072 image_data)
file(WRITE "${TEST_ROOT}/image.bin" "${image_data}")
file(WRITE "${TEST_ROOT}/short.bin" "bad")

function(run_image name expected_exit command scenario)
    set(backup "${TEST_ROOT}/${name}.raw")
    file(REMOVE "${backup}" "${backup}.json")
    set(extra)
    if(command STREQUAL "write")
        set(extra --backup "${backup}")
    endif()
    execute_process(COMMAND "${EXE}" ${command} ${ARGN} --serial ${scenario} ${extra}
        RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT "${code}" STREQUAL "${expected_exit}")
        message(FATAL_ERROR "${name}: expected ${expected_exit}, got ${code}\n${stdout}\n${stderr}")
    endif()
    if(NOT expected_exit EQUAL 0 AND stdout MATCHES "successful")
        message(FATAL_ERROR "${name}: failure reported success: ${stdout}")
    endif()
    set(stderr "${stderr}" PARENT_SCOPE)
    set(stdout "${stdout}" PARENT_SCOPE)
    set(backup "${backup}" PARENT_SCOPE)
endfunction()
function(expect text)
    string(FIND "${stderr}" "${text}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing '${text}': ${stderr}")
    endif()
endfunction()
function(no_mutations)
    expect("MODEL erases=0 programs=0")
endfunction()

run_image(no-confirm 1 write write-ok "${TEST_ROOT}/image.bin")
expect("Supply --yes")
if(stderr MATCHES "MODEL")
    message(FATAL_ERROR "Programmer opened without confirmation")
endif()
run_image(alignment 1 write write-ok "${TEST_ROOT}/short.bin" --yes)
expect("aligned to 131072")
no_mutations()
run_image(offset-alignment 1 write write-ok "${TEST_ROOT}/image.bin" --yes --offset 1)
no_mutations()
run_image(outside 1 write write-ok "${TEST_ROOT}/image.bin" --yes --offset 268435456)
expect("exceeds flash capacity")
no_mutations()
run_image(missing-directory/backup 1 write write-ok "${TEST_ROOT}/image.bin" --yes)
expect("Cannot create new raw backup file")
no_mutations()

foreach(scenario bad-first bad-second marker-error raw-restore-fail backup-ecc backup-drift protected wel)
    run_image(${scenario} 1 write write-${scenario} "${TEST_ROOT}/image.bin" --yes)
    no_mutations()
endforeach()

run_image(dry-run 0 write write-ok "${TEST_ROOT}/image.bin" --dry-run)
expect("MODEL erases=0 programs=0 config=10 protection=3E wel=0")
if(NOT stdout MATCHES "Write dry run")
    message(FATAL_ERROR "Dry run was not identified in output")
endif()

run_image(ok 0 write write-ok "${TEST_ROOT}/image.bin" --yes --offset 131072)
expect("MODEL erases=1 programs=64 config=10 protection=3E wel=0")
file(SIZE "${backup}" size)
if(NOT size EQUAL 139264)
    message(FATAL_ERROR "Incorrect raw main+OOB backup size: ${size}")
endif()
file(READ "${backup}" first LIMIT 4 HEX)
if(NOT first STREQUAL "40414243")
    message(FATAL_ERROR "Backup offset is wrong: ${first}")
endif()
file(READ "${backup}" oob OFFSET 2048 LIMIT 128 HEX)
string(REPEAT "ff" 128 expected_oob)
if(NOT oob STREQUAL expected_oob)
    message(FATAL_ERROR "Raw backup lost spare bytes")
endif()
file(READ "${backup}.json" manifest)
string(JSON offset GET "${manifest}" main_area_offset)
if(NOT offset EQUAL 131072)
    message(FATAL_ERROR "Backup manifest offset is wrong")
endif()
if(NOT stdout MATCHES "Write and verification successful")
    message(FATAL_ERROR "Missing successful write summary")
endif()

# Existing backup files must survive a later invocation unchanged.
execute_process(COMMAND "${EXE}" write "${TEST_ROOT}/image.bin" --serial write-ok --yes --backup "${backup}"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code EQUAL 1 OR error MATCHES "MODEL")
    message(FATAL_ERROR "Existing backup was not rejected before opening hardware")
endif()
file(SIZE "${backup}" size_after)
if(NOT size_after EQUAL size)
    message(FATAL_ERROR "Existing backup was modified")
endif()

run_image(gv 0 write write-gv "${TEST_ROOT}/image.bin" --yes --stay-in-isp)
expect("MODEL erases=1 programs=64 config=18 protection=7C wel=0")
foreach(scenario erase-fail program-fail load-error execute-error mismatch restore-fail)
    run_image(${scenario} 1 write write-${scenario} "${TEST_ROOT}/image.bin" --yes)
    expect("Flash may be partially programmed")
    if(scenario STREQUAL "erase-fail" OR scenario STREQUAL "load-error")
        expect("MODEL erases=1 programs=0")
    elseif(scenario STREQUAL "program-fail" OR scenario STREQUAL "execute-error")
        expect("MODEL erases=1 programs=1")
    else()
        expect("MODEL erases=1 programs=64")
    endif()
endforeach()

run_image(verify-ok 0 verify write-preloaded "${TEST_ROOT}/image.bin")
no_mutations()
run_image(verify-mismatch 1 verify write-ok "${TEST_ROOT}/image.bin")
expect("Verify mismatch at page 0, byte 0")
no_mutations()
