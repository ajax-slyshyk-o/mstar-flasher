# Real CLI and ISP protocol, backed by stateful NAND; no hardware access.
file(MAKE_DIRECTORY "${TEST_ROOT}")
string(REPEAT "A" 131072 image_data)
file(WRITE "${TEST_ROOT}/image.bin" "${image_data}")
file(WRITE "${TEST_ROOT}/short.bin" "bad")
set(with_backup TRUE)

function(run_image name expected_exit command scenario)
    set(backup "${TEST_ROOT}/${name}.raw")
    file(REMOVE "${backup}" "${backup}.json")
    set(extra)
    if(command STREQUAL "write" AND with_backup)
        set(extra --backup "${backup}")
    endif()
    set(selection)
    if(NOT scenario STREQUAL "auto")
        set(selection --serial ${scenario})
    endif()
    execute_process(COMMAND "${EXE}" ${command} ${ARGN} ${selection} ${extra}
        RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT "${code}" STREQUAL "${expected_exit}")
        message(FATAL_ERROR "${name}: expected ${expected_exit}, got ${code}\n${stdout}\n${stderr}")
    endif()
    if(NOT expected_exit EQUAL 0 AND stdout MATCHES "successful")
        message(FATAL_ERROR "${name}: failure reported success: ${stdout}")
    endif()
    if(command STREQUAL "write" AND NOT with_backup)
        if(EXISTS "${backup}" OR EXISTS "${backup}.json" OR
           stdout MATCHES "Raw backup verified" OR
           stderr MATCHES "Backing up flash|Comparing backup with flash|Retain raw backup")
            message(FATAL_ERROR "${name}: backup created or reported without --backup\n${stdout}\n${stderr}")
        endif()
    endif()
    set(stderr "${stderr}" PARENT_SCOPE)
    set(stdout "${stdout}" PARENT_SCOPE)
    set(backup "${backup}" PARENT_SCOPE)
endfunction()
function(expect text)
    string(FIND "${stderr}" "${text}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing '${text}': ${stderr}")
    endif()
endfunction()
function(no_mutations)
    expect("MODEL erases=0 programs=0")
endfunction()

run_image(auto-write 0 write auto "${TEST_ROOT}/image.bin")
expect("MODEL erases=1 programs=64 config=10 protection=3E wel=0")
run_image(auto-dry-run 0 write auto "${TEST_ROOT}/image.bin" --dry-run)
no_mutations()

run_image(alignment 1 write write-ok "${TEST_ROOT}/short.bin")
expect("aligned to 131072")
no_mutations()
run_image(offset-alignment 1 write write-ok "${TEST_ROOT}/image.bin" --offset 1)
no_mutations()
run_image(outside 1 write write-ok "${TEST_ROOT}/image.bin" --offset 268435456)
expect("exceeds flash capacity")
no_mutations()
run_image(missing-directory/backup 1 write write-ok "${TEST_ROOT}/image.bin")
expect("Cannot create new raw backup file")
no_mutations()

foreach(scenario bad-first bad-second marker-error raw-restore-fail backup-ecc backup-drift protected wel)
    run_image(${scenario} 1 write write-${scenario} "${TEST_ROOT}/image.bin")
    no_mutations()
endforeach()

run_image(dry-run 0 write write-ok "${TEST_ROOT}/image.bin" --dry-run)
expect("MODEL erases=0 programs=0 config=10 protection=3E wel=0")
if(NOT stdout MATCHES "Write dry run")
    message(FATAL_ERROR "Dry run was not identified in output")
endif()

run_image(ok 0 write write-ok "${TEST_ROOT}/image.bin" --offset 131072)
expect("MODEL erases=1 programs=64 config=10 protection=3E wel=0")
file(SIZE "${backup}" size)
if(NOT size EQUAL 139264)
    message(FATAL_ERROR "Incorrect raw main+OOB backup size: ${size}")
endif()
file(READ "${backup}" first LIMIT 4 HEX)
if(NOT first STREQUAL "40414243")
    message(FATAL_ERROR "Backup offset is wrong: ${first}")
endif()
file(READ "${backup}" oob OFFSET 2048 LIMIT 128 HEX)
string(REPEAT "ff" 128 expected_oob)
if(NOT oob STREQUAL expected_oob)
    message(FATAL_ERROR "Raw backup lost spare bytes")
endif()
file(READ "${backup}.json" manifest)
string(JSON offset GET "${manifest}" main_area_offset)
if(NOT offset EQUAL 131072)
    message(FATAL_ERROR "Backup manifest offset is wrong")
endif()
if(NOT stdout MATCHES "Write and verification successful")
    message(FATAL_ERROR "Missing successful write summary")
endif()

# Existing backup files must survive a later invocation unchanged.
execute_process(COMMAND "${EXE}" write "${TEST_ROOT}/image.bin" --serial write-ok --backup "${backup}"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code EQUAL 1 OR error MATCHES "MODEL")
    message(FATAL_ERROR "Existing backup was not rejected before opening hardware")
endif()
file(SIZE "${backup}" size_after)
if(NOT size_after EQUAL size)
    message(FATAL_ERROR "Existing backup was modified")
endif()

run_image(gv 0 write write-gv "${TEST_ROOT}/image.bin" --stay-in-isp)
expect("MODEL erases=1 programs=64 config=18 protection=7C wel=0")
foreach(scenario erase-fail program-fail load-error execute-error mismatch restore-fail)
    run_image(${scenario} 1 write write-${scenario} "${TEST_ROOT}/image.bin")
    expect("Flash may be partially programmed")
    if(scenario STREQUAL "erase-fail" OR scenario STREQUAL "load-error")
        expect("MODEL erases=1 programs=0")
    elseif(scenario STREQUAL "program-fail" OR scenario STREQUAL "execute-error")
        expect("MODEL erases=1 programs=1")
    else()
        expect("MODEL erases=1 programs=64")
    endif()
endforeach()

run_image(verify-ok 0 verify write-preloaded "${TEST_ROOT}/image.bin")
no_mutations()
run_image(verify-mismatch 1 verify write-ok "${TEST_ROOT}/image.bin")
expect("Verify mismatch at page 0, byte 0")
no_mutations()

# Vendor config: out-of-order entries, duplicate files, spaces, Windows paths,
# BOM/CRLF, hex and decimal offsets, and partial pages/blocks.
set(config_dir "${TEST_ROOT}/vendor config")
file(MAKE_DIRECTORY "${config_dir}/images")
file(WRITE "${config_dir}/images/small file.bin" "abc")
string(REPEAT "B" 131073 large_image)
file(WRITE "${config_dir}/large.bin" "${large_image}")
string(ASCII 239 187 191 bom)
set(config "${config_dir}/OnebinnandBurnImgConfig.cfg")
file(WRITE "${config}" "${bom}# comment\r\nlarge.bin : 0x80000\r\n\r\n; another comment\r\nimages\\small file.bin : 0\r\n\"images/small file.bin\" : 131072\r\n")

function(check_ranges policy)
    file(READ "${backup}.json" manifest)
    string(JSON format GET "${manifest}" format)
    string(JSON tail GET "${manifest}" tail_policy)
    string(JSON count LENGTH "${manifest}" ranges)
    if(NOT format STREQUAL "mstar-raw-ranges-v2" OR NOT tail STREQUAL "${policy}" OR NOT count EQUAL 3)
        message(FATAL_ERROR "Incorrect config backup manifest: ${manifest}")
    endif()
    foreach(index RANGE 0 2)
        string(JSON offset GET "${manifest}" ranges ${index} main_area_offset)
        string(JSON raw_offset GET "${manifest}" ranges ${index} backup_offset)
        string(JSON raw_size GET "${manifest}" ranges ${index} backup_size)
        string(JSON main_size GET "${manifest}" ranges ${index} main_area_size)
        string(JSON source_size GET "${manifest}" ranges ${index} image_size)
        if(index EQUAL 0)
            set(expected_offset 0)
        elseif(index EQUAL 1)
            set(expected_offset 131072)
        else()
            set(expected_offset 524288)
        endif()
        math(EXPR expected_raw_offset "${index} * 139264")
        if(index EQUAL 2)
            set(expected_source 131073)
            set(expected_main 262144)
            set(expected_raw 278528)
        else()
            set(expected_source 3)
            set(expected_main 131072)
            set(expected_raw 139264)
        endif()
        if(NOT offset EQUAL expected_offset OR NOT raw_offset EQUAL expected_raw_offset OR
           NOT raw_size EQUAL expected_raw OR NOT main_size EQUAL expected_main OR NOT source_size EQUAL expected_source)
            message(FATAL_ERROR "Wrong config range ${index}: ${manifest}")
        endif()
    endforeach()
    file(SIZE "${backup}" size)
    if(NOT size EQUAL 557056)
        message(FATAL_ERROR "Sparse backup includes gaps or omits a block: ${size}")
    endif()
    # Second backed-up block starts at device page 64, not at a file offset.
    file(READ "${backup}" bytes OFFSET 139264 LIMIT 4 HEX)
    if(NOT bytes STREQUAL "40414243")
        message(FATAL_ERROR "Wrong sparse backup contents: ${bytes}")
    endif()
endfunction()

run_image(config-ff 0 write write-config-ff --config "${config}")
expect("MODEL erases=4 programs=256 config=10 protection=3E wel=0")
expect("CONFIG_AUDIT=ok")
check_ranges(fill-ff)
run_image(config-preserve 0 write write-config-preserve --config "${config}" --preserve-gaps)
expect("CONFIG_AUDIT=ok")
check_ranges(preserve)
run_image(config-dry 0 write auto --config "${config}" --dry-run)
no_mutations()
check_ranges(fill-ff)
run_image(config-dry-preserve 0 write auto --config "${config}" --dry-run --preserve-gaps)
no_mutations()
check_ranges(preserve)
run_image(config-bad-gap 0 write write-config-bad-gap --config "${config}")
expect("MODEL erases=4 programs=256")
foreach(scenario bad-later backup-later)
    run_image(config-${scenario} 1 write write-config-${scenario} --config "${config}")
    no_mutations()
endforeach()
run_image(config-mismatch 1 write write-mismatch --config "${config}")
expect("MODEL erases=4 programs=256")
expect("Verify mismatch")

# Bad later entries must be found before the first erase, not after earlier
# images have already been programmed.
set(invalid_config "${config_dir}/invalid.cfg")
foreach(kind missing malformed negative overflow junk empty empty-image overlap duplicate unaligned outside)
    if(kind STREQUAL "missing")
        set(line "missing.bin : 0x80000")
    elseif(kind STREQUAL "malformed")
        set(line "large.bin 0x80000")
    elseif(kind STREQUAL "negative")
        set(line "large.bin : -1")
    elseif(kind STREQUAL "overflow")
        set(line "large.bin : 0x10000000000000000")
    elseif(kind STREQUAL "junk")
        set(line "large.bin : 0x80000junk")
    elseif(kind STREQUAL "empty")
        set(line "# no entries")
    elseif(kind STREQUAL "empty-image")
        file(WRITE "${config_dir}/empty.bin" "")
        set(line "empty.bin : 0x80000")
    elseif(kind STREQUAL "overlap")
        set(line "large.bin : 0x20000\nimages/small file.bin : 0x40000")
    elseif(kind STREQUAL "duplicate")
        set(line "images/small file.bin : 0")
    elseif(kind STREQUAL "unaligned")
        set(line "large.bin : 0x80001")
    elseif(kind STREQUAL "outside")
        set(line "large.bin : 0x10000000")
    endif()
    if(kind STREQUAL "empty")
        file(WRITE "${invalid_config}" "${line}\n")
    else()
        file(WRITE "${invalid_config}" "images/small file.bin : 0\n${line}\n")
    endif()
    run_image(config-invalid-${kind} 1 write write-ok --config "${invalid_config}")
    if(kind MATCHES "^(overlap|duplicate|unaligned|outside)$")
        no_mutations()
    elseif(stderr MATCHES "MODEL")
        message(FATAL_ERROR "Config ${kind} opened programmer before validating inputs")
    endif()
endforeach()

# Mutually exclusive inputs and options fail at CLI parsing, before USB access.
foreach(kind image offset preserve-without-config no-input)
    set(args --config "${config}")
    if(kind STREQUAL "image")
        list(APPEND args "${TEST_ROOT}/image.bin")
    elseif(kind STREQUAL "offset")
        list(APPEND args --offset 0)
    elseif(kind STREQUAL "preserve-without-config")
        set(args "${TEST_ROOT}/image.bin" --preserve-gaps)
    else()
        set(args)
    endif()
    execute_process(COMMAND "${EXE}" write ${args} --backup "${TEST_ROOT}/unused.raw"
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(code EQUAL 0 OR error MATCHES "MODEL")
        message(FATAL_ERROR "Invalid config CLI combination accepted: ${kind}\n${output}\n${error}")
    endif()
endforeach()


# Without --backup, skip all full raw reads and source-page backup reads.
# Post-program ECC verification and bad-block marker checks still run.
set(with_backup FALSE)
run_image(no-backup-write 0 write auto "${TEST_ROOT}/image.bin")
expect("MODEL erases=1 programs=64 config=10 protection=3E wel=0")
expect("MODEL_READS raw_pages=0 main_before_erase=0")
